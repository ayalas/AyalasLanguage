{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrontendsPhysicalFolders": {
    "public": "dist",
    "admin": "admin"
  },
  "Session": {
    "TokenExpirationHours": 8760,
    "AdminTokenExpirationHours": 24
  },
  "ClientBaseAddress": "https://langapp.xyz/",
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=/app/data/AyalasLanguage.db;"
  },
  "EmailConfirmation": {
    "TokenExpirationHours": 168,
    "ResendDelayHours": 1
  },
  "EmailSettings": {
    "Sender": "noreply@langapp.xyz",
    "APIKey": "use secret manager"
  },
  "JobSettings": {
    "DeleteOldLogsJob": {
      "CronExpression": "10 5 * * 6",
      "DaysBack": 180
    },
    "DeleteOldTokensJob": {
      "CronExpression": "40 5 * * 6",
      "DaysBack": 180
    }
  },
  "AI": {
    "ChatEndpoint": "https://hermes.ai.unturf.com/v1/",
    "ChatModel": "solidrust/Hermes-3-Llama-3.1-8B-AWQ",
    "ChatAPIKey": "use secret manager",
    "TTSEndpoint": "http://localhost:5050/v1/audio/speech",
    "TTSModel": "tts-1-f5",
    "TTSAPIKey": "use secret manager"
  },
  "ForgotPassword": {
    "TokenExpirationMinutes": 10,
    "ResendDelayMinutes": 4
  },
  "AllowedHosts": "langapp.xyz;www.langapp.xyz"
}