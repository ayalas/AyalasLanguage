{
  "cli": {
    "version": ">= 21.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "pnpm": "11.8.0" 
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "pnpm": "11.8.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://langapp.xyz",
        "EXPO_PUBLIC_APP_VARIANT": "preview"
      }
    },
    "production": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "autoIncrement": true,
      "channel": "production",
      "pnpm": "11.8.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://langapp.xyz",
        "EXPO_PUBLIC_APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
