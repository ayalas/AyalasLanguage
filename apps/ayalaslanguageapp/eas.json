{
  "cli": {
    "version": ">= 21.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.0", 
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_BASE_URL": "https://langapp.xyz",
        "EXPO_PUBLIC_APP_VARIANT": "preview"
      }
    },
    "production": {
      "distribution": "internal",
      "node": "22.13.0", 
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_BASE_URL": "https://langapp.xyz",
        "EXPO_PUBLIC_APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
