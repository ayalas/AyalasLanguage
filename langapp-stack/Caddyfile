langapp.xyz, www.langapp.xyz {
    tls /langapp-stack/certs/domain.cert.pem /langapp-stack/certs/private.key.pem

    @app_shell path / /index.html /mobile /mobile/ /mobile/* /admin /admin/ /admin/*
    header @app_shell {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    @pwa_files path /manifest.json /mobile/manifest.json /mobile/sw.js /mobile/metadata.json /mobile/_expo/* /mobile/assets/*
    header @pwa_files {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    reverse_proxy 127.0.0.1:8080
}